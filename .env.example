# Application database used by the backend.
DATABASE_URL=postgresql+psycopg://mvp_app:mvp_app_password@localhost:5433/mvp_phase1

# Separate database for repository and migration tests.
TEST_DATABASE_URL=postgresql+psycopg://mvp_app:mvp_app_password@localhost:5433/mvp_phase1_test

# Local Postgres container bootstrap values.
POSTGRES_HOST_PORT=5433
POSTGRES_SUPERUSER_PASSWORD=postgres_password
POSTGRES_APP_USER=mvp_app
POSTGRES_APP_PASSWORD=mvp_app_password
POSTGRES_APP_DB=mvp_phase1
POSTGRES_TEST_DB=mvp_phase1_test

# Single-system MVP defaults.
MODEL_REPO_SYSTEM_ID=demo-legacy-system

# Default evidence root used when the frontend evidence-path field is empty.
EVIDENCE_ROOT=reference/evidence
MODEL_REPO_CHECKOUT=../mvp-phase1-model

# GitHub model repository created manually in Epic A3.
GITHUB_MODEL_REPO=mo-sameh1/mvp-phase1-model
GITHUB_TOKEN=github_pat_placeholder
GITHUB_WEBHOOK_SECRET=github_webhook_secret_placeholder
BACKEND_API_KEY=backend_api_key_placeholder
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://front-production-9849.up.railway.app

# Frontend local development. The Vite dev server calls /api/* and proxies to the backend target.
VITE_API_BASE_PATH=/api
VITE_API_KEY=backend_api_key_placeholder
VITE_DEFAULT_SYSTEM_ID=demo-legacy-system
VITE_JOB_POLLING_MS=3000
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000

# LangSmith tracing and model access for Epic A4/D2 onward.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=langsmith_api_key_placeholder
LANGCHAIN_PROJECT=7bots-mvp-phase1-dev

# Choose one provider for the smoke test and later agent runtime: ollama, groq, or anthropic.
LLM_PROVIDER=ollama

# Ollama settings. Use localhost for local Ollama, or https://ollama.com for Ollama cloud.
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=llama3.1:8b-cloud
OLLAMA_API_KEY=ollama_api_key_placeholder

# Groq hosted model settings. Required only when LLM_PROVIDER=groq.
GROQ_API_KEY=groq_api_key_placeholder
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic hosted model settings. Required only when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=anthropic_api_key_placeholder
ANTHROPIC_MODEL=claude-3-5-haiku-latest
